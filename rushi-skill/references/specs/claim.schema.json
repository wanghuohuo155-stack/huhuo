{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rushi.dev/specs/claim.schema.json",
  "title": "入世 claim 记录（claims.jsonl 单行）",
  "type": "object",
  "required": ["claim_id", "skill_slug", "kind", "title", "source_chapter", "source_quote"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[a-z0-9]+-[0-9]{2,}$"},
    "skill_slug": {"type": "string"},
    "kind": {
      "type": "string",
      "enum": ["framework", "principle", "case", "counter-example", "term"]
    },
    "title": {"type": "string", "minLength": 1},
    "source_chapter": {"type": "string", "minLength": 1},
    "source_quote": {"type": "string", "minLength": 4},
    "source_span": {"type": "string"},
    "summary": {"type": "string"},
    "source_note": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {
      "type": "string",
      "enum": ["pending", "verified", "verified-with-notes", "numeric-review", "unverified", "length-failed", "no-quote"]
    },
    "confidence": {
      "type": "string",
      "enum": ["author-claim", "empirically-supported", "unverified"]
    }
  },
  "additionalProperties": true
}

