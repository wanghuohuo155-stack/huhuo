{
  "project_dir": ".",
  "provider": "openai",
  "json_mode": true,
  "max_output_tokens": 8192,
  "model": "",
  "api_key_env": "OPENAI_API_KEY",
  "base_url": "https://api.openai.com/v1",
  "chunk_size": 50000,
  "quote_max_chars": 150,
  "quote_max_words": 100,
  "min_critiques": 3,
  "min_glossary_terms": 5,
  "telemetry_enabled": true,
  "target_trigger_precision": 0.95,
  "target_trigger_recall": 0.9,
  "bait_tolerance": 0,
  "min_pass_rate": 0.8,
  "mis_trigger_proposal_rate": 0.15,
  "negative_feedback_proposal_min": 3,
  "positive_feedback_promote_min": 10,
  "stale_days": 90,
  "extra": {}
}
